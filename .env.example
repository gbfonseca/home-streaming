# Copie para .env e ajuste. Usado pelo docker-compose.yaml e por scripts/setup.py.

# --- docker-compose ---
# Pasta de mídia (D:\Multimídia no Windows, vista pelo WSL)
MEDIA_DIR=/mnt/d/Multimídia
# Configurações dos apps (mantenha no filesystem Linux do WSL, não em /mnt/*)
CONFIG_DIR=${HOME}/.local/share/home-streaming

# --- scripts/setup.py ---
# qBittorrent: arquivos que nunca são baixados
QBIT_BLOCKED_FILES=*.exe,*.scr,*.bat,*.cmd,*.com,*.pif,*.lnk,*.msi,*.vbs,*.vbe,*.js,*.jse,*.wsf,*.hta,*.ps1,*.jar,*.apk,*.dll,*.reg

# qBittorrent: limite de compartilhamento. Ao atingir, o torrent para e o Radarr/Sonarr
# remove torrent + arquivos de Downloads (após importar). 0 = para ao terminar; -1 = sem limite
QBIT_MAX_RATIO=0
QBIT_MAX_SEEDING_MINUTES=-1

# Bazarr: idioma (pb = Português Brasil) e providers que não exigem login
BAZARR_LANGUAGE=pb
BAZARR_PROFILE_NAME=Português (Brasil)
BAZARR_PROVIDERS=opensubtitlescom,embeddedsubtitles,yifysubtitles,subf2m

# Radarr: tamanho máximo por filme, em GB
RADARR_MAX_GB=15

# Sonarr: tamanho máximo em MB por minuto de episódio (68 ~ 4 GB por episódio de 1h)
SONARR_MAX_MB_PER_MIN=68
